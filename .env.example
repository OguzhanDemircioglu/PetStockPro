# PetStockPro — Environment Variables Template
# Kopya: cp .env.example .env  (sonra değerleri doldur)
# Production değerleri Cloudflare Workers / GitHub Actions secrets'ta tutulur

# ============================================================
# Supabase
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...        # server-side only, ASLA client'ta kullanma

# Postgres connection strings (Drizzle için)
# Frankfurt EU (eu-central-1) — KVKK Madde 9 açık rıza akışıyla
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL_DIRECT=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres   # migration için (pool dışı)

# Schema (multi-tenant izolasyon)
SUPABASE_SCHEMA=petstockpro

# JWT secret (Supabase ile uyumlu — Supabase Settings > API > JWT Secret)
SUPABASE_JWT_SECRET=

# ============================================================
# Auth.js v5 (next-auth beta)
# ============================================================
AUTH_URL=http://localhost:3000                            # production: https://petstockpro.com
AUTH_SECRET=                                              # openssl rand -base64 32 (min 32 char)

# ============================================================
# Cloudflare Turnstile (bot koruması)
# Sprint 2'de aktive — Register + Forgot Password + Change Email zorunlu, Login 5+ fail sonrası conditional
# TECH-STACK §3.9c
# ============================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ============================================================
# OAuth Providers
# Google OAuth İPTAL (2026-05-14 TR-only kararı — auth.html'den çıkarıldı)
# ============================================================

# ============================================================
# E-posta — Brevo SMTP
# ============================================================
BREVO_API_KEY=
BREVO_SENDER_EMAIL=info@petstockpro.com
BREVO_SENDER_NAME=PetStockPro

# ============================================================
# Telegram Bot (admin bildirim kanalı — müşteri tarafı YOK)
# ============================================================
TELEGRAM_BOT_TOKEN=                                       # BotFather'dan al
TELEGRAM_BOT_USERNAME=@PetStockProBot
TELEGRAM_WEBHOOK_SECRET=                                  # Webhook doğrulama için random string

# ============================================================
# Monitoring (Sentry — Sprint 0'da opsiyonel, 100+ event/gün olursa Team plan)
# ============================================================
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=petstockpro
SENTRY_PROJECT=petstockpro

# ============================================================
# Cloudflare (deploy — Sprint 14)
# ============================================================
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# wrangler.toml içinde de bazı değerler var

# ============================================================
# Cloudflare R2 (storage — Sprint E)
# Catalog seed image'ları + tenant ürün resimleri R2'de.
# Bucket: petstockpro-images
# Object key pattern:
#   - seed/{hash}.webp                                 (catalog seed, immutable)
#   - tenants/{companyId}/{productId}/{uuid}.{ext}     (tenant ürün resmi)
# ============================================================
R2_ACCOUNT_ID=                                            # Cloudflare Dashboard sağ üst "Account ID"
R2_ACCESS_KEY_ID=                                         # R2 → Manage R2 API Tokens
R2_SECRET_ACCESS_KEY=                                     # Token oluştururken alınan secret
R2_BUCKET=petstockpro-images
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev                    # Public access URL (custom domain veya r2.dev). Server-side okur, gerekirse prop olarak client'a geçilir (NEXT_PUBLIC_ duplicate gerekmez).

# ============================================================
# Local development DB (Aiven Postgres — production'a çıkınca aktif)
# Şu an dormant — drizzle.config + db/client DATABASE_URL'a yönlendiriyor.
# Production sonrası bu env vars'ı aktifleştirip local dev'i Aiven'a yönlendiririz.
# ============================================================
# LOCAL_DB_HOST=pg-xxxxx.h.aivencloud.com
# LOCAL_DB_PORT=15474
# LOCAL_DB_NAME=defaultdb
# LOCAL_DB_USERNAME=avnadmin
# LOCAL_DB_PASSWORD=
# LOCAL_DB_SCHEMA=petstockpro

# ============================================================
# App Config
# ============================================================
NEXT_PUBLIC_APP_URL=https://petstockpro.com
NEXT_PUBLIC_SITE_URL=https://petstockpro.com              # next.config metadata için (Open Graph)
NEXT_PUBLIC_APP_DOMAIN=petstockpro.com

# ============================================================
# Feature Flags
# ============================================================
NEXT_PUBLIC_ENABLE_REALTIME=true                          # Supabase Realtime
NEXT_PUBLIC_ENABLE_TELEGRAM=true                          # Telegram bot bağlama
NEXT_PUBLIC_ENABLE_VITRIN=true                            # Merkezi vitrin (petstockpro.com/vitrin)
ENABLE_PETPRO_ADVISOR=true                                # Pano akıllı öneriler

# ============================================================
# Ödeme Entegrasyonu (Sprint 13/14)
# ============================================================
# PayTR (TR — ödeme/abonelik tahsilatı). 3 değer PayTR Mağaza Paneli → "Bilgi" sayfasından.
# Callback imzası merchant_key + merchant_salt ile HMAC-SHA256 — ayrı webhook secret YOK.
PAYTR_MERCHANT_ID=                                        # Mağaza No
PAYTR_MERCHANT_KEY=                                       # Mağaza Parola
PAYTR_MERCHANT_SALT=                                      # Mağaza Gizli Anahtarı
PAYTR_TEST_MODE=1                                         # 1 = test ortamı, 0 = canlı
PAYTR_BASE_URL=https://www.paytr.com

# iyzico (TR — eski entegrasyon, PayTR'a geçişte gözden geçirilecek)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com           # prod: https://api.iyzipay.com

# Nilvera e-Arşiv (TR — Sprint 14)
NILVERA_API_KEY=
NILVERA_BASE_URL=https://apitest.nilvera.com             # test; canlı: https://api.nilvera.com
NILVERA_SELLER_VKN=                                       # PetStockPro VKN (10 hane) — şirket kuruluşu sonrası
NILVERA_SELLER_TITLE=                                     # "PetStockPro Yazılım A.Ş." vb.
NILVERA_SERIE=                                            # e-Arşiv fatura serisi (3 karakter, firmaya tanımlı; test hesabı: ABC)

# Paddle MoR — Faz 2 (2026-05-14 TR-only kararı, MVP'de aktif değil)
# PADDLE_VENDOR_ID=
# PADDLE_API_KEY=
# PADDLE_PUBLIC_KEY=

# ============================================================
# Şirket Bilgileri (LANSMAN BLOKER — kuruluş sonrası doldur)
# Yasal sayfalar + e-Arşiv fatura + iyzico üye işyeri başvurusu için zorunlu.
# Boş bırakılırsa landing sayfalarında [PLACEHOLDER] olarak görünür.
# Bkz. /privacy-policy + /terms-of-service + /distance-sales-agreement + /return-policy + /delivery-terms + /contact
# ============================================================
COMPANY_LEGAL_NAME=                                       # Ticari unvan (ör. "PetStockPro Yazılım A.Ş." veya "Ad Soyad - Şahıs Şirketi")
COMPANY_BRAND_NAME=PetStockPro                            # Marka adı (sabit)
COMPANY_VAT_NO=                                           # VKN (10 hane, kurumlar) veya TC (11 hane, şahıs şirketi)
COMPANY_TAX_OFFICE=                                       # Vergi dairesi (ör. "Maslak Vergi Dairesi")
COMPANY_MERSIS_NO=                                        # MERSİS numarası (16 hane) — limited/anonim için
COMPANY_TRADE_REGISTRY_NO=                                # Ticaret sicil numarası — limited/anonim için
COMPANY_TRADE_REGISTRY_OFFICE=                            # Ticaret sicil müdürlüğü (ör. "İstanbul Ticaret Sicili Müdürlüğü")
COMPANY_ADDRESS=                                          # Tam yasal adres (cadde + no + ilçe + il + posta kodu)
COMPANY_PHONE=                                            # Resmi iletişim telefonu (+90 ile başlamalı)
COMPANY_SUPPORT_EMAIL=info@petstockpro.com               # Müşteri destek + KVKK (tek info@ adresi)
COMPANY_KVKK_EMAIL=info@petstockpro.com                   # KVKK veri sorumlusu (tek info@ adresi)
COMPANY_IBAN=                                             # Şirket IBAN (TR + 24 hane) — iyzico tahsilat hesabı
COMPANY_BANK_NAME=                                        # Banka adı (ör. "Garanti BBVA")
COMPANY_KEP_ADDRESS=                                      # KEP adresi — kurumlar için zorunlu, şahıs ş. opsiyonel
COMPANY_LEGAL_JURISDICTION=İstanbul                       # Yetkili mahkeme şehri (uyuşmazlık halinde)

# e-Arşiv fatura için ek
COMPANY_EARSIV_SERIES=PSP                                 # Fatura seri kodu (Nilvera'da tanımlanır)
COMPANY_ACTIVITY_CODE=                                    # NACE kodu (SaaS: 6201.01 = bilgisayar programlama hizmetleri)

# ============================================================
# Dev / Test
# ============================================================
NODE_ENV=development                                      # production / test
LOG_LEVEL=info                                            # error / warn / info / debug
