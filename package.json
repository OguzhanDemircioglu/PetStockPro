    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "motion": "^12.38.0",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.25",
    "next-intl": "^3.26.3",
    "otpauth": "^9.5.1",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.54.2",
