{
  "name": "petstockpro",
  "version": "0.1.0",
  "private": true,
  "description": "PetStockPro — pet shop stok takip + satış kaydı SaaS (multi-tenant, Türkiye)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "cross-env ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed/index.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy:staging": "opennextjs-cloudflare build && wrangler deploy --config wrangler.staging.toml"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.4",
